import "ast.borp"
import "tokentypes.borp"
import "parser.borp"
import "lexer.borp"

private function provFunctions(fnName: str, args: str): str {
    if (fnName == "print") {
        return "printf(\"%g\\n\", " + args + ")"
    }
    if (fnName == "length") {
        return "(double)(" + args + "->length)"
    }
    if (fnName == "push") {
        return "borp_array_push(" + args + ")"
    }
    if (fnName == "pop") {
        return "borp_array_pop(" + args + ")"
    }
}

private function boxExpr(valExpr: table): str {
    if (valExpr.type == astTypes.NUMBER_EXPR) {
        return "borp_val_num(" + genExpr(valExpr) + ")"
    } elseif (valExpr.type == astTypes.STRING_EXPR) {
        return "borp_val_string(" + genExpr(valExpr) + ")"
    } elseif (valExpr.type == astTypes.BOOL_EXPR) {
        return "borp_val_boolean(" + genExpr(valExpr) + ")"
    } elseif (valExpr.type == astTypes.TABLE_EXPR) {
        return "borp_val_table(" + genExpr(valExpr) + ")"
    }

    return "borp_val_string(" + genExpr(valExpr) + ")"
}

private function genExpr(expr: table): str {
    if (expr.type == astTypes.NUMBER_EXPR) {
        return toString(expr.value)
    }
    if (expr.type == astTypes.STRING_EXPR) {
        return '"' + expr.value + '"'
    }
    if (expr.type == astTypes.BOOL_EXPR) {
        if (expr.value) {
            return "true"
        } else {
            return "false"
        }
    }
    if (expr.type == astTypes.ARRAY_EXPR) {
        if (length(expr.elements) == 0) {
            return "borp_array_create(0)"
        } elseif (length(expr.elements) > 0) {
            elems: str = ""
            for i = 0, length(expr.elements) - 1 {
                if (i < length(expr.elements) - 1) {
                    elems = elems + genExpr(expr.elements[i]) + ", "
                } else {
                    elems = elems + genExpr(expr.elements[i])
                }
            }
            return "borp_array_from_elements(" + length(expr.elements) + ", (double[]){" + elems + "})"
        }
    }
    if (expr.type == astTypes.INDEX_EXPR) {
        target: str = genExpr(expr.target)
        key: str = ""
        
        if (expr.key.type == astTypes.STRING_EXPR) {
            key = genExpr(expr.key)
            return "borp_table_get(" + target + ", " + key + ").as.number"
        }

        key: str = genExpr(expr.key)
        return "borp_array_get(" + target + ", (int)(" + key + "))"
    }
    if (expr.type == astTypes.INDEX_ASSIGN_EXPR) {
        target: str = genExpr(expr.target)
        key: str = genExpr(expr.key)
        value: str = genExpr(expr.value)

        if (expr.key.type == astTypes.STRING_EXPR) {
            return "borp_table_set(targetStr, keyStr, " + boxExpr(expr.value) + ")"
        }

        return "borp_array_set(" + target + ", (int)(" + key + "), " + value + ")"
    }
    if (expr.type == astTypes.TABLE_EXPR) {
        if (length(expr.fields) == 0) {
            return "borp_table_create(0)"
        } elseif (length(expr.fields) > 0) {
            keys: str = ""
            vals: str = ""
            for i = 0, length(expr.fields) - 1 {
                if (i < length(expr.fields) - 1) {
                    keys = keys + "\"" + expr.fields[i].key + "\", "
                    vals = vals + boxExpr(expr.fields[i].value) + ", "
                } else {
                    keys = keys + "\"" + expr.fields[i].key + "\""
                    vals = vals + boxExpr(expr.fields[i].value)
                }
            }
            return "borp_table_from_entries(" + toString(length(expr.fields)) + ", (const char*[]){" + keys + "}, (BorpValue[]){" + vals + "})"
        }
    }
    if (expr.type == astTypes.NULL_EXPR) {
        return "NULL"
    }
    if (expr.type == astTypes.IDENTIFIER_EXPR) {
        return expr.value
    }
    if (expr.type == astTypes.ASSIGN_EXPR) {
        return expr.name + " = " + genExpr(expr.value)
    }
    if (expr.type == astTypes.CALL_EXPR) {
        args: str = ""
        if (length(expr.arguments) > 0) {
            for i = 0, length(expr.arguments) - 1 {
                if (i < length(expr.arguments) - 1) {
                    args = args + genExpr(expr.arguments[i]) + ", "
                } else {
                    args = args + genExpr(expr.arguments[i])
                }
            }
        }
        builtin = provFunctions(expr.callee.value, args)

        if (builtin ~= null) {
            return builtin
        }

        return genExpr(expr.callee) + "(" + args + ")"
    }

    if (expr.type == astTypes.UNARY_EXPR) {
        if (expr.tokenType == tokenTypes.MINUS) {
            return "(-" + genExpr(expr.operand) + ")"
        } else {
            return "(! " + genExpr(expr.operand) + ")"
        }
    }

    if (expr.type == astTypes.BINARY_EXPR) {
        operand: str = ""
        if (expr.tokenType == tokenTypes.PLUS) {
            operand = "+"
        } elseif (expr.tokenType == tokenTypes.MINUS) {
            operand = "-"
        } elseif (expr.tokenType == tokenTypes.STAR) {
            operand = "*"
        } elseif (expr.tokenType == tokenTypes.SLASH) {
            operand = "/"
        } elseif (expr.tokenType == tokenTypes.EQUALS) {
            operand = "=="
        } elseif (expr.tokenType == tokenTypes.NOT_EQUAL) {
            operand = "!="
        } elseif (expr.tokenType == tokenTypes.GREATER_EQUAL) {
            operand = ">="
        } elseif (expr.tokenType == tokenTypes.LESSER_EQUAL) {
            operand = "<="
        } elseif (expr.tokenType == tokenTypes.LESSER) {
            operand = "<"
        } elseif (expr.tokenType == tokenTypes.GREATER) {
            operand = ">"
        } elseif (expr.tokenType == tokenTypes.AND) {
            operand = "&&"
        } elseif (expr.tokenType == tokenTypes.OR) {
            operand = "||"
        }

        return "(" + genExpr(expr.left) + " " + operand + " " + genExpr(expr.right) + ")"
    }
}

private function cType(typeAnno: num): str {
    if (typeAnno == types.NUMBER) {
        return "double"
    } elseif (typeAnno == types.DOUBLE) {
        return "double"
    } elseif (typeAnno == types.FLOAT) {
        return "float"
    } elseif (typeAnno == types.INTEGER) {
        return "int"
    } elseif (typeAnno == types.STRING) {
        return "const char*"
    } elseif (typeAnno == types.BOOLEAN) {
        return "bool"
    } elseif (typeAnno == types.ENUM) {
        return "enum"
    } elseif (typeAnno == types.ARRAY) {
        return "BorpArray*"
    } elseif (typeAnno == types.TABLE) {
        return "BorpTable*"
    }

    return "void"
}

private function genFunction(statement: table): str {
    retType: str = cType(statement.returnType)
    params: str = ""
    body: str = genStatementList(statement.body)

    if (length(statement.parameters) == 0) {
        params = ""
    } else {
        for i = 0, length(statement.parameters) - 1 {
            p = statement.parameters[i]
            if (i < length(statement.parameters) - 1) {
                params = params + cType(p.type) + " " + p.name + ", "
            } else {
                params = params + cType(p.type) + " " + p.name
            }
        }
    }

    if (statement.returnType == types.ANY) {
        retType = "void"
    }

    if (statement.isPrivate) {
        retType = "static " + retType
    }

    return retType + " " + statement.name + "(" + params + ") {\n" + body + "}\n"
}

private function genStatementList(statements: array): str {
    out: str = ""

    if (length(statements) == 0) {
        return ""
    }

    for i = 0, length(statements) - 1 {
        out = out + genStatement(statements[i])
    }

    return out
}

private function genStatement(statement: table): str {
    if (statement.type == statementTypes.EXPRESSION_STATEMENT) {
        return genExpr(statement.expression) + ";\n"
    }
    if (statement.type == statementTypes.VARDECLARE_STATEMENT) {
        typeStr = cType(statement.typeAnnotation)

        if (statement.initializer.type == astTypes.ENUM_EXPR) {
            enumMembers: str = ""
            for i = 0, length(statement.initializer.members) - 1 {
                member: table = statement.initializer.members[i]
                if (i < length(statement.initializer.members) - 1) {
                    enumMembers = enumMembers + member.name + " = " + member.value + ",\n"
                } else {
                    enumMembers = enumMembers + member.name + " = " + member.value
                }
            }
            return typeStr + " {\n" + enumMembers +  "};\n"
        }

        return typeStr + " " + statement.name + " = " + genExpr(statement.initializer) + ";\n"
    }
    if (statement.type == statementTypes.RETURN_STATEMENT) {
        if (statement.value ~= null) {
            return "return " + genExpr(statement.value) + ";\n"
        } else {
            return "return;\n"
        }
    }
    if (statement.type == statementTypes.BREAK_STATEMENT) {
        return "break;\n"
    }
    if (statement.type == statementTypes.BLOCK_STATEMENT) {
        return "{\n " + genStatementList(statement.statements) + "}\n"
    }
    if (statement.type == statementTypes.WHILE_STATEMENT) {
        return "while (" + genExpr(statement.condition) + ") {\n" + genStatementList(statement.body) + "}\n"
    }
    if (statement.type == statementTypes.IF_STATEMENT) {
        if (length(statement.elseBranch) > 0) {
            out: str = "if (" + genExpr(statement.condition) + ") {\n" + genStatementList(statement.thenBranch) + "}"

            if (length(statement.elseBranch) == 0) {
                out = out + "\n"
                return out
            } elseif (length(statement.elseBranch) == 1 && statement.elseBranch[0].type == statementTypes.IF_STATEMENT) {
                out = out + "else " + genStatement(statement.elseBranch[0])
                return out
            } else {
                out = out + " else {\n" + genStatementList(statement.elseBranch) + "}\n"
                return out
            }
        } else {
            return "if (" + genExpr(statement.condition) + ") {\n" + genStatementList(statement.thenBranch) + "}\n"
        }
    }
    if (statement.type == statementTypes.FOR_STATEMENT) {
        if (statement.isCStyle) {
            c1 = genExpr(statement.clause1)
            c2 = genExpr(statement.clause2)
            c3 = genExpr(statement.clause3)

            return "for (" + c1 + "; " + c2 + "; " + c3 + ") {\n" + genStatementList(statement.body) + "}\n"
        } else {
            varName: str = statement.clause1.name
            startVal: str = genExpr(statement.clause1.value)
            stopVal: str = genExpr(statement.clause2)
            stepVal: str = "1"
            if (statement.clause3 ~= null) {
                stepVal = genExpr(statement.clause3)
            }
            return "for (double " + varName + " = " + startVal + "; " + varName + " <= " + stopVal + "; " + varName + " += " + stepVal + ") {\n" + genStatementList(statement.body) + "}\n"
        }
    }
}

private function generateArrayStruct(): str {
    return "typedef struct BorpArray {\n double* data;\nint length;\nint capacity;\n} BorpArray;\n\n"
}

private function generateTableStructAndTagged(): str {
    enums: str = "typedef enum {\nVAL_NULL,\nVAL_NUMBER,\nVAL_BOOL,\nVAL_STRING,\nVAL_ARRAY,\nVAL_TABLE\n} BorpValueType;\n\n"
    struct: str = "typedef struct BorpValue {\n BorpValueType type;\n union {\nint integer;\ndouble number;\nfloat floatInt;\nbool boolean;\n const char* string;\n struct BorpArray* array;\n struct BorpTable* table;} as;} BorpValue;\n\n"
    entryStruct: str = "typedef struct {\n const char* key; BorpValue value;} BorpTableEntry;\n\n"
    tableStruct: str = "typedef struct {\n BorpTableEntry* entries;\n int count;\n int capacity;} BorpTable;\n\n"

    out: str = enums + struct + entryStruct + tableStruct
    return out
}

private function generateArrayMethods(): str {
    out: str = ""
    out = out + "BorpArray* borp_array_create(int capacity) {\nBorpArray* borparray = malloc(sizeof(BorpArray));\nif (capacity < 4) {capacity = 4;}\nborparray->capacity = capacity;\nborparray->data = malloc(sizeof(double) * capacity);\nborparray->length = 0;\nreturn borparray;\n}\n\n"
    out = out + "BorpArray* borp_array_push(BorpArray* arr, double val) {\n if (arr->length >= arr->capacity) {\narr->capacity = arr->capacity * 2;\narr->data = realloc(arr->data, sizeof(double) * arr->capacity);\n}\narr->data[arr->length] = val;\n arr->length++; return arr;\n}\n\n"
    out = out + "double borp_array_get(BorpArray* arr, int index) {\nreturn arr->data[index];\n}\n\n"
    out = out + "void borp_array_set(BorpArray* arr, int index, double val) {\narr->data[index] = val;\n}\n\n"
    out = out + "BorpArray* borp_array_from_elements(int count, double elements[]) {\nBorpArray* arr = borp_array_create(count);\n for (int i = 0; i < count; i++) {\nborp_array_push(arr, elements[i]);}\n return arr;\n}\n\n"
    out = out + "double borp_array_pop(BorpArray* arr) {\ndouble val = arr->data[arr->length - 1];\narr->length--;\nreturn val;\n}\n\n"

    return out
}

private function generateTableMethods(): str {
    out: str = ""
    out = out + "BorpTable* borp_table_create(int capacity) {\nBorpTable* table = malloc(sizeof(BorpTable));\nif (capacity < 8) {capacity = 8;}\ntable->count = 0;\ntable->capacity = capacity;\ntable->entries = malloc(sizeof(BorpTableEntry) * capacity);\nfor (int i = 0; i < table->capacity; i++) {\ntable->entries[i].key = NULL;} return table;\n}\n\n"
    out = out + "void borp_table_set(BorpTable* table, const char* key, BorpValue val) {\nuint32_t hash = borp_hash_string(key);\nint index = hash % table->capacity;\n while (true) {\nif (table->entries[index].key == NULL) {\ntable->entries[index].key = key;\ntable->entries[index].value = val;\ntable->count++;\n return;\n}\n else if (strcmp(table->entries[index].key, key) == 0) {\ntable->entries[index].value = val; return;\n}\n else {\nindex = (index + 1) % table->capacity;}\n}\n\n}\n\n"
    out = out + "BorpValue borp_table_get(BorpTable* table, const char* key) {\nuint32_t hash = borp_hash_string(key);\n int index = hash % table->capacity;\nwhile (true) {\nif (table->entries[index].key == NULL) {\nreturn (BorpValue){.type = VAL_NULL};\n}\nelse if (strcmp(table->entries[index].key, key) == 0) {\nreturn table->entries[index].value;\n}\nelse {\nindex = (index + 1) % table->capacity;\n}\n}\n}\n\n"
    out = out + "BorpValue borp_val_num(double n) {\nBorpValue v;\nv.type = VAL_NUMBER;\nv.as.number = n;\nreturn v;\n}\n\n"
    out = out + "BorpValue borp_val_string(const char* s) {\nBorpValue v;\nv.type = VAL_STRING;\nv.as.string = s;\nreturn v;\n}\n\n"
    out = out + "BorpValue borp_val_boolean(bool b) {\nBorpValue v;\nv.type = VAL_BOOL;\nv.as.boolean = b;\nreturn v;\n}\n\n"
    out = out + "BorpValue borp_val_table(BorpTable* t){\nBorpValue v;\nv.type = VAL_TABLE;\nv.as.table = t;\nreturn v;\n}\n\n"
    out = out + "BorpTable* borp_table_from_entries(int count, const char* keys[], BorpValue values[]) {\nBorpTable* table = borp_table_create(count * 2);\nfor (int i = 0; i < count; i++) {\nborp_table_set(table, keys[i], values[i]);\n}\nreturn table;\n}\n\n"

    return out
}

function generateProgram(statements: array): str {
    functionsCode: str = ""
    mainCode: str = ""

    for i = 0, length(statements) - 1 {
        stmt = statements[i]
        if (stmt.type == statementTypes.FUNCTION_STATEMENT) {
            functionsCode = functionsCode + genFunction(stmt) + "\n"
        } else {
            mainCode = mainCode + genStatement(stmt)
        }
    }

    out: str = "#include <stdio.h>\n#include <stdbool.h>\n#include <stdlib.h>\n#include <stdint.h>\n\n"
    out = out + "static unsigned int borp_hash_string(const char* key) {\nunsigned int hash = 2166136261u;\n for (int i = 0; key[i] != '\0'; i++) {\nhash ^= (unsigned char)key[i];\n hash *= 16777619u;};\n return hash;}"
    out = out + "struct BorpTable;\n\n"
    out = out + generateArrayStruct()
    out = out + generateArrayMethods()
    out = out + generateTableStructAndTagged()
    out = out +  generateTableMethods()
    out = out + functionsCode
    out = out + "int main(int argc, char** argv) {\n"
    out = out + mainCode
    out = out + "    return 0;\n"
    out = out + "}\n"

    return out
}

function testCompiler(source: str) {
    source = readFile("src/test.borp")

    // 2. Lex & Parse
    tokens = tokenize(lexerState(source))
    ast = parseProgram(parseState(tokens))

    // 3. Generate C code
    cCode = generateProgram(ast)

    // 4. Save the .c file
    writeFile("math_test.c", cCode)
}

testCompiler("x: num = 10\ny: num = 20\ntotal: num = (x + y) * 2\nif total > 50 {\n    total = total - 5\n} else {\n    total = total + 5\n}\nwhile total > 0 {\n    total = total - 1\n}")